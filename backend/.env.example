PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/safety_app

# Twilio (for SMS alerts to emergency contacts)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000

# Police helpline API (placeholder - requires formal MOU with local police)
# Leave as-is if no police integration; alerts will be logged locally only
POLICE_API_URL=https://example-police-integration.local/api/alert
POLICE_API_KEY=replace_me

# ML microservice (uvicorn main:app --port 6000)
ML_SERVICE_URL=http://localhost:6000

# Frontend URL (for live tracking share links)
FRONTEND_URL=http://localhost:5173

# Web Push (VAPID keys for browser push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@yourdomain.com
